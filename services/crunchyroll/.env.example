# Crunchyroll backend for Fanoos. Copy to .env and fill in. Never commit .env.

BACKEND_TOKEN=
PORT=8789
PUBLIC_URL=http://localhost:5180

# Client credentials of Crunchyroll's Android TV app (base64 "id:secret") and its version.
# There's no official API; community-maintained at github.com/crunchy-labs/artifacts
# (credentials.json → android_tv: basic_auth_token, version + "_" + version_code).
CRUNCHYROLL_BASIC_AUTH=
CRUNCHYROLL_APP_VERSION=

REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=600
CACHE_STALE_SECONDS=86400
