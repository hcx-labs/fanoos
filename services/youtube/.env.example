# YouTube backend for Fanoos. Copy to .env and fill in. Never commit .env.

# Shared with Fanoos core (apps/server/.env BACKEND_TOKEN).
BACKEND_TOKEN=
PORT=8788
# The app's public origin (Google returns through core's proxy at /api/b/youtube/public/oauth/callback).
PUBLIC_URL=http://localhost:5180

# Google OAuth client. Authorized redirect URI must be exactly:
#   ${PUBLIC_URL}/api/b/youtube/public/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API key (public data only; saves linked accounts' quota).
YOUTUBE_API_KEY=

# Invidious companion (streaming). Secret must be exactly 16 characters.
COMPANION_URL=http://127.0.0.1:8282
COMPANION_SECRET=
COMPANION_SIGNED_IN_URL=
COMPANION_COOKIES=

REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=600
CACHE_STALE_SECONDS=86400
