# Settings for compose.yaml. Copy to .env next to it and fill in. Never commit .env.

# Where people open Fanoos (core serves the app and the API). Use your real https URL in production.
PUBLIC_URL=http://localhost:8787
FANOOS_PORT=8787
# Pin a release (e.g. 0.2.0) or follow the newest.
FANOOS_VERSION=latest

# Shared secret between core and the backends: openssl rand -base64 32
BACKEND_TOKEN=
# Exactly 16 characters, for the streaming companion.
COMPANION_SECRET=

# Optional: if YouTube refuses this server's address (companion log: "Failed to validate PO token"),
# start the warp service (docker compose --profile warp up -d) and route the companions through it.
COMPANION_PROXY=
# COMPANION_PROXY=socks5://warp:1080
# Optional WARP+ licence key for the warp service (free WARP is used without one). If you add it
# after WARP has registered, remove the warp-data volume so it registers again with the key.
WARP_LICENSE_KEY=

# YouTube: Google OAuth client (redirect URI: ${PUBLIC_URL}/api/b/youtube/public/oauth/callback) and a Data API key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Crunchyroll (optional, needs Premium; unofficial, see the README).
CRUNCHYROLL_BASIC_AUTH=
CRUNCHYROLL_APP_VERSION=

# Optional single sign-on (turns off password and passkey sign-in).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
