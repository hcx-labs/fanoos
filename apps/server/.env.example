# Copy to apps/server/.env and fill in. Never commit .env.

# Where the web app is served. Cookies, OAuth redirects and passkeys are bound to this origin.
PUBLIC_URL=http://localhost:5180
PORT=8787

# Google OAuth client (Google Cloud Console → Google Auth Platform → Clients → Web application).
# Authorized redirect URI must be exactly: ${PUBLIC_URL}/api/links/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. YouTube Data API key for public data (no user access). Restrict it to the YouTube Data API v3 in Cloud Console.
YOUTUBE_API_KEY=

# Optional. 32+ random bytes, base64 (openssl rand -base64 32). Generated into data/secret.key if unset.
# SECRET_KEY=

# Optional. Where the SQLite database and secret live (default ./data).
# DATA_DIR=./data

# Invidious companion (streaming; run with `npm run companion`). Secret must be exactly 16 characters.
COMPANION_URL=http://127.0.0.1:8282
COMPANION_SECRET=
# Optional second instance, signed in, used only for age-restricted videos (`npm run companion:signed-in`).
# Leave empty to keep everything signed out.
COMPANION_SIGNED_IN_URL=
# Optional: cookie header for the signed-in instance; without it, it uses Google device sign-in.
COMPANION_COOKIES=

# Redis cache (npm run redis). Leave empty to use a small in-memory cache instead.
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=600
# After expiring, cached responses are still served for this long while they refresh in the background.
CACHE_STALE_SECONDS=86400

# Single sign-on (OpenID Connect). Setting OIDC_ISSUER turns it on, and then password and
# passkey sign-in are disabled entirely; accounts are created automatically on first sign-in.
# Register this redirect URI with your provider: ${PUBLIC_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional:
# OIDC_SCOPES=openid email profile
# OIDC_NAME=Authentik
