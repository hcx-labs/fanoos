{
  "name": "tube",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run redis & npm run companion & npm run dev --workspace @fanoos/youtube & npm run dev --workspace @fanoos/crunchyroll & npm run dev --workspace @tube/server & npm run dev --workspace @tube/web",
    "build": "npm run build --workspace @tube/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "companion": "scripts/companion.sh",
    "companion:signed-in": "scripts/companion.sh signed-in",
    "redis": "scripts/redis.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-or-later"
}
